<Window
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  x:Class="TextBridge.MainWindow"
  Title="TextBridge"
  Width="750" Height="500"
  MinWidth="750" MinHeight="500"
  Icon="/textbridge.ico"
  Topmost="False"
  ExtendClientAreaToDecorationsHint="True"
  ExtendClientAreaChromeHints="PreferSystemChrome"
  ExtendClientAreaTitleBarHeightHint="32"
>
  <Grid>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,8,0,0" Spacing="8" ZIndex="999">
      <TextBlock Text="TextBridge" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
    </StackPanel>
    <Button x:Name="pinbutton" HorizontalAlignment="Right" VerticalAlignment="Top" Background="Transparent" BorderThickness="0" Padding="6,4" Margin="0,4,145,0" ToolTip.Tip="always on top" ZIndex="999" Width="32" Height="24">
      <Viewbox Width="12" Height="12">
        <Path x:Name="pinpath" Fill="Gray" Data="M16,12V4H17V2H7V4H8V12L6,14V16H11.2V22H12.8V16H18V14L16,12Z"/>
      </Viewbox>
    </Button>
    <Grid Margin="10,40,10,10">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="10"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <StackPanel Grid.Column="0" Spacing="10">
      <TextBlock Text="Api Settings" FontSize="16" FontWeight="Bold" Margin="0,0,0,5"/>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="10"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="10"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="10"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="10"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="Provider" VerticalAlignment="Center"/>
        <Grid Grid.Row="0" Grid.Column="2">
          <ComboBox x:Name="providerdrop" MinWidth="115" MaxWidth="115"/>
          <StackPanel x:Name="localllmpanel" Orientation="Horizontal" Spacing="5" HorizontalAlignment="Right" IsVisible="False" Margin="0,0,5,0">
            <TextBox x:Name="localipbox" Watermark="ip address" Width="100" Height="24"/>
            <TextBox x:Name="localportbox" Watermark="port" Width="55" Height="24"/>
          </StackPanel>
        </Grid>

        <TextBlock Grid.Row="2" Grid.Column="0" Text="Model" VerticalAlignment="Center"/>
        <Grid Grid.Row="2" Grid.Column="2">
          <ComboBox x:Name="modeldrop" MinWidth="200"/>
          <Button x:Name="refreshmodels" HorizontalAlignment="Right" VerticalAlignment="Center" Background="Transparent" BorderThickness="0" Padding="8,4" Margin="0,0,2,0" IsVisible="False" ToolTip.Tip="refresh models">
            <Viewbox Width="14" Height="14">
              <Path Fill="White" Data="M12 4V1L8 5l4 4V6c3.31 0 6 2.69 6 6 0 1.01-.25 1.97-.7 2.8l1.46 1.46C19.54 15.03 20 13.57 20 12c0-4.42-3.58-8-8-8zm0 14c-3.31 0-6-2.69-6-6 0-1.01.25-1.97.7-2.8L5.24 7.74C4.46 8.97 4 10.43 4 12c0 4.42 3.58 8 8 8v3l4-4-4-4v3z"/>
            </Viewbox>
          </Button>
        </Grid>

        <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3" IsVisible="False">
        </StackPanel>

        <TextBlock Grid.Row="6" Grid.Column="0" Text="Api Key" VerticalAlignment="Center" x:Name="apikeylabel"/>
        <Grid Grid.Row="6" Grid.Column="2">
          <TextBox x:Name="keybox" Watermark="enter api key" PasswordChar="●"/>
          <Button x:Name="eyebutton" HorizontalAlignment="Right" VerticalAlignment="Center" Background="Transparent" BorderThickness="0" Padding="8,4" Margin="0,0,2,0">
            <Viewbox Width="14" Height="14">
              <Path x:Name="eyepath" Fill="White" Data="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z"/>
            </Viewbox>
          </Button>
        </Grid>
      </Grid>

      <TextBlock Text="Translation" FontSize="16" FontWeight="Bold" Margin="0,10,0,5"/>
      <StackPanel Spacing="10">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>

          <CheckBox Grid.Column="0" x:Name="incomingcheck" Content="enable incoming to" VerticalAlignment="Center"/>
          <ComboBox Grid.Column="2" x:Name="intargetdrop"/>
        </Grid>

        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>

          <CheckBox Grid.Column="0" x:Name="outgoingcheck" Content="enable outgoing to" VerticalAlignment="Center"/>
          <ComboBox Grid.Column="2" x:Name="outtargetdrop"/>
        </Grid>

        <StackPanel Spacing="5" Orientation="Horizontal">
          <CheckBox x:Name="chatcheck" Content="Talk"/>
          <CheckBox x:Name="shoutcheck" Content="Shout"/>
          <CheckBox x:Name="whispercheck" Content="Whisper"/>
        </StackPanel>

        <TextBlock Text="Custom Instructions" FontSize="12" FontWeight="SemiBold" Margin="0,10,0,5"/>
        <TextBox x:Name="custominstructionsbox" Watermark="AI instructions..." TextWrapping="Wrap" AcceptsReturn="True" Height="100"/>
      </StackPanel>
    </StackPanel>

    <Border Grid.Column="2" BorderBrush="#333" BorderThickness="1" CornerRadius="5">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="Chat Log" FontSize="16" FontWeight="Bold" Margin="10,10,10,5"/>
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" x:Name="logscroll">
          <ItemsControl x:Name="loglist" Margin="5"/>
        </ScrollViewer>
      </Grid>
    </Border>
  </Grid>
  </Grid>
</Window>
